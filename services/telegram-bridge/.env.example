# Copy this file to .env.local. The local file is gitignored.
# Fill API ID/hash, then run `pnpm telegram:authorize`; the command writes
# TELEGRAM_SESSION locally without printing it.
TELEGRAM_BRIDGE_HOST=127.0.0.1
TELEGRAM_BRIDGE_PORT=8788
TELEGRAM_BRIDGE_ADAPTER=gramjs
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_BRIDGE_SHARED_SECRET=
TELEGRAM_REQUEST_CONCURRENCY=32
TELEGRAM_REQUEST_TIMEOUT_MS=30000
TELEGRAM_MEDIA_CONCURRENCY=3
TELEGRAM_MEDIA_TIMEOUT_MS=120000
TELEGRAM_SHUTDOWN_GRACE_MS=30000
TELEGRAM_SEARCH_INDEX_TTL_MS=30000
TELEGRAM_SEARCH_INDEX_MAX_DOCUMENTS=10000
TELEGRAM_SEARCH_INDEX_MAX_CHARACTERS=20000000
TELEGRAM_SEARCH_BUILD_TIMEOUT_MS=60000

{
	"name": "armenian-apostolic-digital-library",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "react-router build",
		"postbuild": "node scripts/sanitize-build-output.mjs",
		"lint": "tsc -p services/telegram-bridge/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
		"test": "pnpm build && tsx --test tests/*.test.ts",
		"test:telegram-live": "TELEGRAM_LIVE_TEST=1 node --env-file=services/telegram-bridge/.env.local --import tsx --test tests/telegram-bridge-live.test.ts",
		"dev": "react-router dev",
		"telegram:authorize": "tsx services/telegram-bridge/src/authorize.ts",
		"telegram:discover-chats": "tsx services/telegram-bridge/src/discover-chats.ts",
		"bridge:mock": "TELEGRAM_BRIDGE_ADAPTER=mock TELEGRAM_ALLOWED_CHAT_IDS=-100900 TELEGRAM_BRIDGE_SHARED_SECRET=fixture_bridge_secret_000000000000000000 tsx services/telegram-bridge/src/server.ts",
		"bridge:start": "node --env-file-if-exists=services/telegram-bridge/.env.local --import tsx services/telegram-bridge/src/server.ts",
		"bridge:typecheck": "tsc -p services/telegram-bridge/tsconfig.json --noEmit",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrations:list:local": "wrangler d1 migrations list DB --local",
		"db:migrate:staging": "wrangler d1 migrations apply armenian-apostolic-digital-library-staging --remote --env staging",
		"db:migrate:production": "wrangler d1 migrations apply armenian-apostolic-digital-library-production --remote --env production",
		"typecheck": "wrangler types && react-router typegen && tsc -b && pnpm bridge:typecheck",
		"deploy": "pnpm run build && wrangler deploy",
		"deploy:staging": "CLOUDFLARE_ENV=staging pnpm run build && wrangler deploy --env staging",
		"deploy:production": "CLOUDFLARE_ENV=production pnpm run build && wrangler deploy --env production",
		"preview": "pnpm run build && vite preview",
		"cf-typegen": "wrangler types",
		"postinstall": "wrangler types"
	},
	"dependencies": {
		"big-integer": "^1.6.52",
		"isbot": "^5.1.36",
		"jose": "^6.2.12",
		"lucide-react": "^1.55.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.4.0",
		"telegram": "^2.26.22"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.63.1",
		"@react-router/dev": "^8.4.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"miniflare": "5.20261006.1-alpha",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vite": "^8.0.3",
		"wrangler": "^4.149.0"
	}
}

# Staging Telegram Bridge — copy into the hosting provider's secret store.
# Never commit a filled copy. The staging allowlist must contain only the test chat.
TELEGRAM_BRIDGE_HOST=0.0.0.0
TELEGRAM_BRIDGE_PORT=8788
TELEGRAM_BRIDGE_ADAPTER=gramjs
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_BRIDGE_SHARED_SECRET=
TELEGRAM_REQUEST_CONCURRENCY=32
TELEGRAM_REQUEST_TIMEOUT_MS=30000
TELEGRAM_MEDIA_CONCURRENCY=3
TELEGRAM_MEDIA_TIMEOUT_MS=120000
TELEGRAM_SHUTDOWN_GRACE_MS=30000

# Cloud sync watcher (VPS). Copy to /opt/library/cloud-sync.env on the server, fill it there,
# and keep it readable only by root (chmod 600). Never commit a filled copy.

# Which Cloudflare environment to write to: staging or production.
CLOUD_SYNC_ENV=staging

# Cloudflare API token with D1:Edit and Workers R2 Storage:Edit for this account only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Telegram user session (created on your Mac with `pnpm telegram:authorize`).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_CONTENT_CHAT_ID=
# Required by the shared config loader; any random value, e.g. `openssl rand -hex 32`.
TELEGRAM_BRIDGE_SHARED_SECRET=

# Optional tuning.
CLOUD_SYNC_DEBOUNCE_MS=8000
CLOUD_SYNC_RECONCILE_MINUTES=360

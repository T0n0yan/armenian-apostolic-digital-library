/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "armenian-apostolic-digital-library",
	"compatibility_date": "2026-10-06",
	"main": "./workers/app.ts",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "armenian-apostolic-digital-library-local",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "armenian-apostolic-library-media-local"
		}
	],
	// The site's alarm clock (workers/clock.ts): the sync 15 minutes after new posts, and each
	// reminder at its own minute, in place of a cron every minute. SQLite-backed: free plan.
	"durable_objects": {
		"bindings": [{ "name": "CLOCK", "class_name": "Clock" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Clock"] }],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// No per-version preview addresses (…-<version>-….workers.dev): old versions stay unreachable.
	"preview_urls": false,
	"env": {
		"staging": {
			"name": "armenian-apostolic-digital-library-staging",
			"preview_urls": false,
			// Every minute: sends due reading reminders; every 30 minutes also starts the Telegram →
			// cloud sync on GitHub (workers/app.ts).
			// Once a night (00:17 UTC, 04:17 in Yerevan): what no event announces (workers/app.ts).
			"triggers": { "crons": ["17 0 * * *"] },
			"durable_objects": {
				"bindings": [{ "name": "CLOCK", "class_name": "Clock" }]
			},
			"vars": {
				"PUBLIC_URL": "https://staging.apostolic.am",
				// Pictures and recordings straight from R2 behind the CDN (app/data/media-url.server.ts).
				"MEDIA_BASE_URL": "https://media-staging.apostolic.am",
				// Web Push public key; the private half is the VAPID_PRIVATE_JWK secret.
				"VAPID_PUBLIC_KEY": "BLjRkHQtrhXZusTlLWoBA_aTzoMe8Ed03SwoSG98FRMBzXmTPWc3giv2aE5fcymivjRaOwKmCgQZ30UmGMCGABo",
				"VAPID_SUBJECT": "mailto:info@apostolic.am",
				// The private support group and its topics (app/data/telegram-bot-replies.server.ts);
				// both bots are admins there, each relays only replies to its own messages.
				"SUPPORT_CHAT_ID": "-1004327865153",
				"SUPPORT_TOPIC_SUPPORT": "2",
				"SUPPORT_TOPIC_CONTACT": "7",
				"SUPPORT_TOPIC_PLACES": "41"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "armenian-apostolic-digital-library-staging",
					"database_id": "cdd921dc-f70c-494a-a7f4-6e0b18c3fd14",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "armenian-apostolic-library-media-staging"
				}
			]
		},
		"production": {
			"name": "armenian-apostolic-digital-library",
			"preview_urls": false,
			// Every minute: sends due reading reminders; every 30 minutes also starts the Telegram →
			// cloud sync on GitHub when GITHUB_SYNC_TOKEN is set (workers/app.ts).
			// Once a night (00:17 UTC, 04:17 in Yerevan): what no event announces (workers/app.ts).
			"triggers": { "crons": ["17 0 * * *"] },
			"durable_objects": {
				"bindings": [{ "name": "CLOCK", "class_name": "Clock" }]
			},
			"vars": {
				"PUBLIC_URL": "https://apostolic.am",
				// This site's bot is in the library group: its posts start the sync (for both sites).
				"SYNC_ON_POSTS": "1",
				// Pictures and recordings straight from R2 behind the CDN, once new DNS has reached Armenian
				// resolvers (app/data/media-url.server.ts).
				"MEDIA_BASE_URL": "https://media.apostolic.am",
				"MEDIA_DIRECT_FROM": "2026-10-22T04:00:00Z",
				// Web Push public key; the private half is the VAPID_PRIVATE_JWK secret.
				"VAPID_PUBLIC_KEY": "BLjRkHQtrhXZusTlLWoBA_aTzoMe8Ed03SwoSG98FRMBzXmTPWc3giv2aE5fcymivjRaOwKmCgQZ30UmGMCGABo",
				"VAPID_SUBJECT": "mailto:info@apostolic.am",
				// The private support group and its topics (app/data/telegram-bot-replies.server.ts);
				// both bots are admins there, each relays only replies to its own messages.
				"SUPPORT_CHAT_ID": "-1004327865153",
				"SUPPORT_TOPIC_SUPPORT": "2",
				"SUPPORT_TOPIC_CONTACT": "7",
				"SUPPORT_TOPIC_PLACES": "41"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "armenian-apostolic-digital-library-production",
					"database_id": "a6141d10-fdf4-4fca-85a2-11d7c8628958",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "armenian-apostolic-library-media-production"
				}
			]
		}
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}

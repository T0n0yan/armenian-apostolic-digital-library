/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "armenian-apostolic-digital-library",
	"compatibility_date": "2026-10-06",
	"main": "./workers/app.ts",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "armenian-apostolic-digital-library-local",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "armenian-apostolic-library-media-local"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"env": {
		"staging": {
			"name": "armenian-apostolic-digital-library-staging",
			// Every minute: sends due reading reminders; every 30 minutes also starts the Telegram →
			// cloud sync on GitHub (workers/app.ts).
			"triggers": { "crons": ["* * * * *"] },
			"vars": {
				"PUBLIC_URL": "https://armenian-apostolic-digital-library-staging.armenian-apostolic-digital-library.workers.dev",
				// Web Push public key; the private half is the VAPID_PRIVATE_JWK secret.
				"VAPID_PUBLIC_KEY": "BLjRkHQtrhXZusTlLWoBA_aTzoMe8Ed03SwoSG98FRMBzXmTPWc3giv2aE5fcymivjRaOwKmCgQZ30UmGMCGABo",
				"VAPID_SUBJECT": "mailto:t0n0yan.contact@gmail.com"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "armenian-apostolic-digital-library-staging",
					"database_id": "cdd921dc-f70c-494a-a7f4-6e0b18c3fd14",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "armenian-apostolic-library-media-staging"
				}
			]
		},
		"production": {
			"name": "armenian-apostolic-digital-library",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "armenian-apostolic-digital-library-production",
					"database_id": "a6141d10-fdf4-4fca-85a2-11d7c8628958",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "armenian-apostolic-library-media-production"
				}
			]
		}
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
